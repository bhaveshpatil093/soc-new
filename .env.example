# ============================================================
# TADS Environment Configuration
# Temporal Anomaly Detection System
#
# Copy this file to .env and fill in your credentials.
# NEVER commit the .env file. (Constraint #4)
# ============================================================

# Elasticsearch connection (Constraint #1, #3)
ES_HOST=https://your-elasticsearch-host:9200
ES_USERNAME=your_username
ES_PASSWORD=your_password

# Optional: Elasticsearch CA certificate path (for TLS verification)
# ES_CA_CERT_PATH=/path/to/ca.crt

# Optional: Disable TLS verification (NOT recommended for production)
# ES_VERIFY_CERTS=true
