# ============================================================
# TADS Environment Configuration
# Temporal Anomaly Detection System
#
# Copy this file to .env and fill in your credentials.
# NEVER commit the .env file. (Constraint #4)
# ============================================================

# Kibana connection (Constraint #1, #3)
# Access is READ-ONLY through the Kibana dashboard.
# Kibana proxies search requests to the underlying Elasticsearch cluster.
KIBANA_HOST=https://your-kibana-host:5601
KIBANA_USERNAME=your_username
KIBANA_PASSWORD=your_password

# Optional: CA certificate path for TLS verification
# KIBANA_CA_CERT_PATH=/path/to/ca.crt

# Optional: Disable TLS verification (NOT recommended for production)
# KIBANA_VERIFY_CERTS=true
