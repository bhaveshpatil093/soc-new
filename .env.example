# ============================================================
# TADS Environment Configuration
# Temporal Anomaly Detection System
#
# Copy this file to .env and fill in your credentials.
# NEVER commit the .env file. (Constraint #4)
# ============================================================

# Elasticsearch/Kibana connection
# ELASTIC_HOST: The full URL to the Elasticsearch or Kibana cluster (e.g. https://es.example.com:9200)
ELASTIC_HOST=https://your-elastic-host:9200

# ELASTIC_USERNAME: Username for authentication
ELASTIC_USERNAME=your_username

# ELASTIC_PASSWORD: Password for authentication. MUST be kept secret.
ELASTIC_PASSWORD=your_password

# ELASTIC_CA_CERT: (Optional) Absolute path to CA certificate for TLS verification
# ELASTIC_CA_CERT=/path/to/ca.crt

# ELASTIC_VERIFY_TLS: (Optional) Whether to verify TLS certificates (true/false, default true)
# ELASTIC_VERIFY_TLS=true

# ELASTIC_TIMEOUT: (Optional) Client timeout in seconds (must be positive, default 30.0)
# ELASTIC_TIMEOUT=30.0
