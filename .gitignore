# ============================================================
# TADS .gitignore
# Temporal Anomaly Detection System
# ============================================================

# --- Credentials & Secrets (Constraint #4) ---
.env
.env.*
!.env.example
*.pem
*.key
*.crt
secrets/
credentials/

# --- Data artifacts (Constraint #16: Parquet only, but gitignore all data) ---
data/
artifacts/models/
artifacts/stats/
# Manifests ARE tracked (they contain no credentials)
# artifacts/manifests/ is NOT ignored

# --- CSV ban (Constraint #16) ---
*.csv

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
*.whl
.eggs/

# --- Virtual environments ---
.venv/
venv/
env/
ENV/

# --- IDE ---
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# --- Testing ---
.pytest_cache/
.coverage
htmlcov/
.hypothesis/

# --- Jupyter ---
.ipynb_checkpoints/

# --- mypy / type checking ---
.mypy_cache/
.dmypy.json

# --- ruff ---
.ruff_cache/

# Test Artifacts
bench*.txt
run*.txt
artifacts/july/

